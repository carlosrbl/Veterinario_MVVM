<UserControl x:Class="Veterinario_MVVM.Views.AdmisionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Veterinario_MVVM.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="950"
             Background="#F8FAFC">

    <UserControl.DataContext>
        <vm:AdmisionViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <ControlTemplate x:Key="MiPlantillaErrorPersonalizada">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right" 
                        Background="#DC2626" 
                        CornerRadius="9" 
                        Width="18" Height="18" 
                        Margin="4,0,0,0" 
                        VerticalAlignment="Center"
                        ToolTip="{Binding [0].ErrorContent}"
                        Cursor="Help">
                    <TextBlock Text="!" 
                               Foreground="White" 
                               FontWeight="Bold" 
                               FontSize="11" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>

                <AdornedElementPlaceholder x:Name="customAdorner"/>
            </DockPanel>
        </ControlTemplate>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0,0,0,4" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Validation.ErrorTemplate" Value="{StaticResource MiPlantillaErrorPersonalizada}" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip" Value="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}" />
                    <Setter Property="BorderBrush" Value="#DC2626" />
                    <Setter Property="Background" Value="#FEF2F2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Validation.ErrorTemplate" Value="{StaticResource MiPlantillaErrorPersonalizada}" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#1E293B" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
        <StackPanel>

            <Border Background="#0F172A" Padding="14" CornerRadius="6" Margin="0,0,0,15">
                <Grid>
                    <TextBlock Text="🐾 VetCare Studio - Admisión Hospitalaria y Preoperatorio" 
                               Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MensajeEstado}" 
                               Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <GroupBox Header="1. IDENTIFICACIÓN Y BIOMETRÍA DEL PACIENTE" Margin="0,0,0,15">
                <Grid TextElement.FontWeight="Normal">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Microchip (15 dígitos ISO):" Target="{Binding ElementName=txtMicrochip}"/>
                            <TextBlock Text=" ⏳ Verificando en REIAC..." Foreground="#D97706" FontWeight="SemiBold" FontSize="11" Margin="8,2,0,0"
                                       Visibility="{Binding IsVerificandoMicrochip, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <TextBox x:Name="txtMicrochip" 
                                 Text="{Binding Microchip, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"/>
                        <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtMicrochip}" 
                                   Foreground="#DC2626" FontSize="11" Margin="2,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,12">
                        <Label Content="Nombre de la Mascota:" Target="{Binding ElementName=txtNombreMascota}"/>
                        <TextBox x:Name="txtNombreMascota" 
                                 Text="{Binding NombreMascota, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"/>
                        <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtNombreMascota}" 
                                   Foreground="#DC2626" FontSize="11" Margin="2,3,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,10,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <Label Content="Especie:"/>
                            <ComboBox SelectedValue="{Binding Especie, Mode=TwoWay}" SelectedValuePath="Content">
                                <ComboBoxItem Content="Perro"/>
                                <ComboBoxItem Content="Gato"/>
                                <ComboBoxItem Content="Ave"/>
                                <ComboBoxItem Content="Exótico"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <Label Content="Raza:" Target="{Binding ElementName=txtRaza}"/>
                            <TextBox x:Name="txtRaza" Text="{Binding Raza, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,12">
                        <Label Content="Fecha de Nacimiento:"/>
                        <DatePicker SelectedDate="{Binding FechaNacimiento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                        <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource AncestorType=StackPanel}}" 
                                   Foreground="#DC2626" FontSize="11" Margin="2,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,0">
                        <Label Content="Peso Clínico (kg):" Target="{Binding ElementName=txtPeso}"/>
                        <TextBox x:Name="txtPeso" Text="{Binding Peso, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"/>
                        <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtPeso}" 
                                   Foreground="#DC2626" FontSize="11" Margin="2,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,0">
                        <Label Content="Temperatura Corporal (°C):" Target="{Binding ElementName=txtTemp}"/>
                        <TextBox x:Name="txtTemp" Text="{Binding Temperatura, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"/>
                        <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtTemp}" 
                                   Foreground="#DC2626" FontSize="11" Margin="2,3,0,0"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Header="2. TITULAR Y CONTACTO DE URGENCIA" Margin="0,0,0,15">
                <Grid TextElement.FontWeight="Normal">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                        <Label Content="DNI / NIE del Titular:" Target="{Binding ElementName=txtDni}"/>
                        <TextBox x:Name="txtDni" Text="{Binding TitularDni, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"/>
                        <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtDni}" 
                                   Foreground="#DC2626" FontSize="11" Margin="2,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,12">
                        <Label Content="Nombre Completo del Titular:" Target="{Binding ElementName=txtTitularNombre}"/>
                        <TextBox x:Name="txtTitularNombre" Text="{Binding TitularNombre, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"/>
                        <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtTitularNombre}" 
                                   Foreground="#DC2626" FontSize="11" Margin="2,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                        <Label Content="Teléfono Urgencias (9 dígitos):" Target="{Binding ElementName=txtTelefono}"/>
                        <TextBox x:Name="txtTelefono" Text="{Binding TitularTelefono, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"/>
                        <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtTelefono}" 
                                   Foreground="#DC2626" FontSize="11" Margin="2,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
                        <Label Content="Correo Electrónico (Informes):" Target="{Binding ElementName=txtEmail}"/>
                        <TextBox x:Name="txtEmail" Text="{Binding TitularEmail, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"/>
                        <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtEmail}" 
                                   Foreground="#DC2626" FontSize="11" Margin="2,3,0,0"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Header="3. PROTOCOLO QUIRÚRGICO Y HOSPITALIZACIÓN (REGLAS CONDICIONALES)" Margin="0,0,0,15">
                <StackPanel TextElement.FontWeight="Normal">
                    <CheckBox Content="El paciente requiere intervención quirúrgica o sedación profunda" 
                              IsChecked="{Binding RequiereCirugia, Mode=TwoWay}" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <Grid Visibility="{Binding RequiereCirugia, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                            <Label Content="Horas de Ayuno (Mín. 8h):" Target="{Binding ElementName=txtAyuno}"/>
                            <TextBox x:Name="txtAyuno" Text="{Binding HorasAyuno, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"/>
                            <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtAyuno}" 
                                       Foreground="#DC2626" FontSize="11" Margin="2,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,12">
                            <Label Content="Tipo de Cirugía / Procedimiento:" Target="{Binding ElementName=txtCirugia}"/>
                            <TextBox x:Name="txtCirugia" Text="{Binding TipoIntervencion, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"/>
                            <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=txtCirugia}" 
                                       Foreground="#DC2626" FontSize="11" Margin="2,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                            <CheckBox Content="Consentimiento informado firmado por el titular legal (Requisito estricto)" 
                                      IsChecked="{Binding ConsentimientoFirmado, Mode=TwoWay}" Foreground="#0284C7" FontWeight="Bold"/>
                            <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource AncestorType=StackPanel}}" 
                                       Foreground="#DC2626" FontSize="11" Margin="2,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <Border Background="#E2E8F0" Padding="12" CornerRadius="6">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Probar Errores" Command="{Binding CargarCasoInvalidoCommand}" Width="120" Height="34" Margin="0,0,8,0" Background="#DC2626" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                        <Button Content="Probar Válido" Command="{Binding CargarCasoValidoCommand}" Width="120" Height="34" Margin="0,0,8,0" Background="#16A34A" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                        <Button Content="Limpiar" Command="{Binding LimpiarCommand}" Width="90" Height="34" Background="#475569" Foreground="White" BorderThickness="0"/>
                    </StackPanel>

                    <Button Content="REGISTRAR ADMISIÓN (✓)" Command="{Binding RegistrarAdmisionCommand}" 
                            HorizontalAlignment="Right" Width="200" Height="34" 
                            Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>